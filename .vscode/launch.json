{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust build and debug active file",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/${fileBasenameNoExtension}",
            "windows": {
                "program": "${workspaceFolder}\\target\\debug\\${fileBasenameNoExtension}.exe"
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"],
            "preLaunchTask": "Rust: build active file"
        },
        {
            "name": "g++.exe build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.out",
            "windows": {
                "name": "g++.exe build and debug active file",
                "type": "cppdbg",
                "request": "launch",
                "program": "${fileDirname}\\${fileBasenameNoExtension}.exe"
            },
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: build active file with IO"
        }
    ]
}
